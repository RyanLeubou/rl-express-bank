# =====================================================================
# RL EXPRESS BANK — variables d'environnement
# Copier via : python3 scripts/generate_env.py   (génère .env avec secrets aléatoires)
# Les valeurs __GENERATE__ sont remplacées automatiquement. Ne jamais versionner .env.
# =====================================================================

# ---- Général ----
COMPOSE_PROJECT_NAME=rlbank
# Profils Docker actifs : core (application), tools (Mailpit).
# Profils ajoutés plus tard : siem (phase 14), observability (phase 15).
COMPOSE_PROFILES=core,tools
APP_ENV=development
APP_NAME=RL EXPRESS BANK
APP_VERSION=0.2.1
LOG_LEVEL=INFO
# Mode laboratoire : autorise le contexte de simulation signé (phase 17). false hors démonstration.
LAB_MODE=true
PUBLIC_BASE_URL=https://bank.localhost
ALLOWED_HOSTS=bank.localhost,localhost,127.0.0.1,api
# Vide = même origine via Caddy (recommandé). Exemple : https://bank.localhost
CORS_ORIGINS=
DOCS_ENABLED=true
TIMEZONE=Africa/Douala
# false (recommandé) : aucun compte pré-créé ; chacun crée son compte sur /inscription, le personnel avec
# « make staff ». true : ajoute du personnel et des clients FICTIFS aux mots de passe connus et publics :
# uniquement pour une démonstration sur votre propre machine, jamais sur une instance accessible à d'autres.
SEED_DEMO_DATA=false

# ---- IA ----
# LLM de RL SOLUTION : modèle open source hébergé chez Groq (offre gratuite, sans carte bancaire).
# Créez votre propre clé sur https://console.groq.com/keys et collez-la ci-dessous. Ne la partagez jamais
# et ne la publiez pas (dépôt Git, capture d'écran). Clé vide = réponses par mots-clés uniquement.
# Tout service compatible OpenAI convient (ex. OpenRouter : https://openrouter.ai/api/v1, modèle « …:free »).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Délai max d'une réponse du LLM (s)
LLM_TIMEOUT_SECONDS=30

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rlbank
# Super-utilisateur d'amorçage : utilisé uniquement par l'image PostgreSQL au premier démarrage.
POSTGRES_USER=rlbank_bootstrap
POSTGRES_PASSWORD=__GENERATE__
# Propriétaire du schéma : utilisé uniquement par les migrations Alembic.
RLBANK_OWNER_USER=rlbank_owner
RLBANK_OWNER_PASSWORD=__GENERATE__
# Rôle applicatif : droits DML uniquement, utilisé par l'API et le worker.
RLBANK_APP_USER=rlbank_app
RLBANK_APP_PASSWORD=__GENERATE__

# ---- Valkey ----
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=__GENERATE__

# ---- Secrets applicatifs ----
APP_SECRET_KEY=__GENERATE__
# Clé AES-256 (base64, 32 octets) pour chiffrer les secrets TOTP (phase 9).
DATA_ENCRYPTION_KEY=__GENERATE_B64_32__
# Clé HMAC des codes de retrait sans carte (phase 8).
CARDLESS_HMAC_KEY=__GENERATE__
# Clé HMAC du contexte de simulation signé (phase 17).
LAB_CONTEXT_HMAC_KEY=__GENERATE__
# Secret partagé de l'intégration Wazuh vers l'API (phase 14).
WAZUH_WEBHOOK_SECRET=__GENERATE__

# ---- JWT : clés Ed25519 générées automatiquement au premier démarrage (volume jwt_keys) ----
JWT_PRIVATE_KEY_PATH=/app/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/secrets/jwt_public.pem
JWT_ACCESS_TTL_SECONDS=600

# ---- Mailpit (e-mails simulés) ----
SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---- Frontend ----
# dev = serveur Vite avec rechargement à chaud ; prod = build statique servi par Caddy
FRONTEND_TARGET=dev
